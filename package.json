{
  "name": "philon-desktop",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "tauri": "tauri",
    "engine:package": "zsh scripts/package-engine.sh",
    "tauri:package": "npm run engine:package && npm run tauri build",
    "release:verify": "zsh scripts/verify-release.sh",
    "local-only:check": "node tests/local-only-policy.mjs",
    "sbom:check": "node tests/sbom-policy.mjs",
    "test": "npm run test:ui && npm run test:engine && npm run build",
    "test:engine": ".venv/bin/python -m unittest engine/test_engine.py engine/test_socket.py engine/test_fuzz.py bench/test_run.py -v",
    "test:ui": "vitest run",
    "test:bench": ".venv/bin/python -m unittest bench/test_run.py -v",
    "license:check": "node tests/license-policy.mjs"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "jsdom": "^29.1.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.5"
  }
}
